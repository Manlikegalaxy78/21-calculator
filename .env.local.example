# Copy this file to .env.local and fill in YOUR OWN keys.
# .env.local is already git-ignored — never commit real keys.
# Use TEST MODE keys for everything until you're ready to go live.

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# Stripe — Developers -> API keys (use the TEST versions, they start with pk_test_ / sk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                    # from `stripe listen` output when testing locally

# Stripe Price IDs — Products -> create two Prices, then paste their IDs here
STRIPE_PRICE_MONTHLY=price_...     # recurring, £5.99/month
STRIPE_PRICE_LIFETIME=price_...    # one-time, £19.99

# Where your app runs locally
NEXT_PUBLIC_SITE_URL=http://localhost:3000
